{
  "name": "ps-multi-timer",
  "version": "1.0.0",
  "description": "PlayStation Multi Timer - عدّادات بلايستيشن",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build-portable": "electron-builder --win portable"
  },
  "author": "PS Timer",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.pstimer.app",
    "productName": "PS Multi Timer",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "PS-Multi-Timer.exe"
    },
    "files": [
      "main.js",
      "PS-Timer.html"
    ]
  }
}